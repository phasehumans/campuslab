{
    "name": "campuslab",
    "module": "index.ts",
    "type": "module",
    "private": true,
    "workspaces": [
        "web",
        "server"
    ],
    "scripts": {
        "format": "prettier . --write",
        "check-format": "prettier . --check",
        "seed": "bun run --filter backend seed",
        "lint": "bun run --filter '*' lint",
        "test": "bun run --filter '*' test"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/bun": "latest",
        "eslint": "^9.0.0",
        "eslint-plugin-react": "^7.37.0",
        "eslint-plugin-react-hooks": "^5.0.0",
        "globals": "^15.0.0",
        "prettier": "^3.8.1",
        "typescript-eslint": "^8.0.0"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "overrides": {
        "@codemirror/state": "6.7.1",
        "@codemirror/view": "6.43.8"
    }
}
